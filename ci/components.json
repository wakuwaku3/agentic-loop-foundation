{
  "version": 1,
  "all_on_change": [".github/**", "ci/**", "devbox.json", "devbox.lock", "go.mod", "go.sum", "Makefile", "scripts/**", "infra/**", "Containerfile"],
  "components": [
    {"id":"ci","roots":["ci/**","cmd/ci-plan/**","internal/ci/**"],"public_contracts":["ci/**"],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-ci"}},
    {"id":"contracts","roots":["contracts/**"],"public_contracts":["contracts/**"],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-contracts"}},
    {"id":"control-plane","roots":["cmd/control-plane/**"],"public_contracts":["contracts/openapi/openapi-v1.yaml"],"contract_dependencies":["contracts/openapi/openapi-v1.yaml"],"dependencies":["api"],"check":{"runner":"make","target":"component-control-plane"}},
    {"id":"runner","roots":["cmd/runner/**","cmd/bootstrap/**","internal/runner/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":["domain","update"],"check":{"runner":"make","target":"component-runner"}},
    {"id":"provider","roots":["internal/provider/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-provider"}},
    {"id":"reconciler","roots":["internal/reconciler/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":["application","domain","store-memory","store-firestore"],"check":{"runner":"make","target":"component-reconciler"}},
    {"id":"release","roots":["internal/release/**"],"public_contracts":[],"contract_dependencies":["contracts/schemas/release-contract.json"],"dependencies":["domain","contracts"],"check":{"runner":"make","target":"component-release"}},
    {"id":"scheduler","roots":["internal/scheduler/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-scheduler"}},
    {"id":"legacy-import","roots":["cmd/legacy-import/**","internal/legacyimport/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-legacy-import"}},
    {"id":"update","roots":["internal/update/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-update"}},
    {"id":"domain","roots":["internal/domain/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-domain"}},
    {"id":"application","roots":["internal/application/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":["domain"],"check":{"runner":"make","target":"component-application"}},
    {"id":"store-memory","roots":["internal/store/memory/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":["domain","application"],"check":{"runner":"make","target":"component-store-memory"}},
    {"id":"store-firestore","roots":["internal/store/firestore/**","firestore.indexes.json"],"public_contracts":[],"contract_dependencies":[],"dependencies":["domain","application"],"check":{"runner":"make","target":"component-store-firestore"}},
    {"id":"api","roots":["internal/api/**"],"public_contracts":["contracts/openapi/openapi-v1.yaml"],"contract_dependencies":["contracts/openapi/openapi-v1.yaml"],"dependencies":["application","domain","web"],"check":{"runner":"make","target":"component-api"}},
    {"id":"web","roots":["internal/web/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-web"}},
    {"id":"internal-contracts","roots":["internal/contracts/**"],"public_contracts":[],"contract_dependencies":["contracts/**"],"dependencies":["contracts"],"check":{"runner":"make","target":"component-contracts"}},
    {"id":"docs","roots":["docs/**","README.md","AGENTS.md"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-docs"}},
    {"id":"tooling","roots":[".editorconfig",".gitignore"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-tooling"}},
    {"id":"environment","roots":["devbox.json","devbox.lock","go.mod","go.sum","Makefile","scripts/**","firebase.json",".github/**","Containerfile"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-tooling"}},
    {"id":"infra","roots":["infra/**","internal/quota/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":["store-firestore"],"check":{"runner":"make","target":"component-infra"}},
    {"id":"repository-meta","roots":[".codex/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-tooling"}},
    {"id":"task-ledger","roots":[".agents/**"],"public_contracts":[],"contract_dependencies":[],"dependencies":[],"check":{"runner":"make","target":"component-tooling"}}
  ]
}
