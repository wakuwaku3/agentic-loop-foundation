  },
  "limits": [
    {
      "resource": "firestore-reads-per-day",
      "ceiling": 25000,
      "unit": "operations",
      "window": "day",
      "enforced_by": "internal/quota.Budget.Reads",
      "fail_closed": true
    },
    {
      "resource": "firestore-writes-per-day",
      "ceiling": 10000,
      "unit": "operations",
      "window": "day",
      "enforced_by": "internal/quota.Budget.Writes",
      "fail_closed": true
    },
    {
      "resource": "firestore-deletes-per-day",
      "ceiling": 10000,
      "unit": "operations",
      "window": "day",
      "enforced_by": "internal/quota.Budget.Deletes",
      "fail_closed": true
    },
    {
      "resource": "firestore-stored-bytes",
      "ceiling": 268435456,
      "unit": "bytes",
      "window": "total",
      "enforced_by": "internal/quota.StorageBudget.PayloadBytes",
      "fail_closed": true
    },
    {
      "resource": "cloud-run-instance-seconds-per-month",
      "ceiling": 360000,
      "unit": "instance-seconds",
      "window": "month",
      "enforced_by": "infra/main.tf cpu=0.08 memory=512Mi",
      "fail_closed": true
    },
    {
      "resource": "cloud-run-requests-per-month",
      "ceiling": 1000000,
      "unit": "requests",
      "window": "month",
      "enforced_by": "Cloud Run always-free monthly request tier",
      "fail_closed": true
    },
    {
      "resource": "cloud-scheduler-jobs",
      "ceiling": 0,
      "unit": "jobs",
      "window": "total",
      "enforced_by": "enable_reconcile_scheduler=false",
      "fail_closed": true
    }
  ],
  "rollback": {
    "trigger": "the applied revision fails verification or serves degraded traffic",
    "argv": [
      "tofu",
      "-chdir=infra",
      "apply",
      "-input=false",
      "build/rollback.tfplan"
    ],
    "completion_conditions": [
      "100 percent of traffic is served by the revision built from the previous digest",
      "tofu plan -refresh-only -detailed-exitcode exits 0",
      "/healthz returns 200 through IAP",
      "a sampled read of canonical Firestore documents has the same content digest as before the rollback"
    ]
  },
  "verification": [
    {
      "name": "no drift",
      "argv": [
        "tofu",
        "-chdir=infra",
        "plan",
        "-refresh-only",
        "-detailed-exitcode"
      ],
      "expected": "exit code 0",
      "read_only": true
    },
    {
      "name": "unauthenticated request is refused",
      "argv": [
        "curl",
        "-sS",
        "-o",
        "/dev/null",
        "-w",
        "%{http_code}",
        "https://control-plane.example.run.app/"
      ],
      "expected": "302 or 403, never 200",
      "read_only": true
    }
  ]
}
