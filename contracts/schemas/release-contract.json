{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-loop.dev/schemas/release-contract-v1.json",
  "title": "Release contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "created_at", "correlation_id", "release", "capabilities", "verification", "rollback"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"const": "release-contract"},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"},
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "status": {"enum": ["preview", "stable"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}}
    },
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["procedure", "target"], "properties": {"procedure": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}}
  }
}
