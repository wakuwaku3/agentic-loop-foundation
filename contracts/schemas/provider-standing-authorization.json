{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-loop.dev/schemas/provider-standing-authorization-v1.json",
  "title": "Provider standing authorization",
  "description": "The human owner's standing authorization for Provider CLI usage inside a contracted flat-rate subscription, recorded once so that individual provider-preflight records can reference it instead of seeking a fresh per-task or per-invocation monetary approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "created_at", "approver", "approved_at", "scope", "providers", "reference"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "provider-standing-authorization"},
    "created_at": {"type": "string", "format": "date-time"},
    "approver": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"},
    "approved_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1, "maxLength": 512},
    "providers": {"type": "array", "minItems": 1, "items": {"enum": ["codex", "claude", "opencode"]}},
    "reference": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
