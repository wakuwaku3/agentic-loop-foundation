{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-loop.dev/schemas/capability-declaration-set-v1.json",
  "title": "Capability declaration set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "created_at",
    "correlation_id",
    "release",
    "contract_ref",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "capability-declaration-set"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "user_action",
          "observable_result",
          "preview_exercise",
          "external_dependencies",
          "outcome_conditions",
          "evidence_retention",
          "documentation",
          "owner_surfaces",
          "evidence_schema",
          "promotion_prerequisites"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "user_action": {
            "type": "string",
            "minLength": 1
          },
          "observable_result": {
            "type": "string",
            "minLength": 1
          },
          "preview_exercise": {
            "type": "string",
            "minLength": 1
          },
          "external_dependencies": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "systems",
              "providers",
              "scopes"
            ],
            "properties": {
              "systems": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "providers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "outcome_conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "success",
              "failure",
              "rollback"
            ],
            "properties": {
              "success": {
                "type": "string",
                "minLength": 1
              },
              "failure": {
                "type": "string",
                "minLength": 1
              },
              "rollback": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "evidence_retention": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "retention"
            ],
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "retention": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "documentation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preview"
            ],
            "properties": {
              "preview": {
                "type": "string",
                "minLength": 1
              },
              "stable": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "owner_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_schema": {
            "type": "string",
            "minLength": 1
          },
          "promotion_prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exercise_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
