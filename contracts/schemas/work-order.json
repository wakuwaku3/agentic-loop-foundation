{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-loop.dev/schemas/work-order-v1.json",
  "title": "Work order",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "created_at", "correlation_id", "problem_brief_ref", "design_packet_ref", "observable_outcome", "allowed_paths", "prohibited_paths", "contracts_changed", "acceptance_criteria", "validation", "constraints", "failure_stop"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"const": "work-order"},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1},
    "problem_brief_ref": {"type": "string", "minLength": 1},
    "design_packet_ref": {"type": "string", "minLength": 1},
    "observable_outcome": {"type": "string", "minLength": 1, "maxLength": 2000},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prohibited_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contracts_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "working_directory", "timeout_seconds"],
      "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "working_directory": {"type": "string", "minLength": 1}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}}
    },
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure_stop": {"type": "boolean"},
    "tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
