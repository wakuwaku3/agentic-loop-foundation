{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentic-loop.dev/schemas/work-packet-v1.json", "title": "Work packet", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "created_at", "correlation_id", "task_id", "objective", "scope", "inputs", "instructions", "acceptance"],
  "properties": {"schema_version": {"const": "v1"}, "id": {"type": "string", "minLength": 1}, "kind": {"const": "work-packet"}, "created_at": {"type": "string", "format": "date-time"}, "correlation_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "pattern": "^V2-[0-9]{3}$"}, "objective": {"type": "string", "minLength": 1, "maxLength": 2000}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "inputs": {"type": "array", "items": {"type": "string"}}, "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "artifact_refs": {"type": "array", "items": {"$ref": "artifact-ref.json"}}, "checkpoint": {"type": "string", "maxLength": 128}}
}
