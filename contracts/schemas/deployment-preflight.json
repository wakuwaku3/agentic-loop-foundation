{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-loop.dev/schemas/deployment-preflight-v1.json",
  "title": "Deployment preflight record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "created_at", "correlation_id", "task_id", "target", "limits", "rollback", "verification", "approval"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "deployment-preflight"},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "pattern": "^V2-[0-9]{3}$"},
    "expires_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "maxLength": 4096},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "project_ref", "installation_id", "region", "service_name", "image_digest", "plan_digest"],
      "properties": {
        "environment": {"enum": ["live", "lab"]},
        "project_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{5,29}$"},
        "installation_id": {"type": "string", "minLength": 1, "maxLength": 21, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
        "region": {"type": "string", "minLength": 1, "maxLength": 64},
        "service_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "image_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "ceiling", "unit", "window", "enforced_by", "fail_closed"],
        "properties": {
          "resource": {"type": "string", "minLength": 1, "maxLength": 64},
          "ceiling": {"type": "number"},
          "unit": {"type": "string", "minLength": 1, "maxLength": 32},
          "window": {"enum": ["day", "month", "total"]},
          "enforced_by": {"type": "string", "minLength": 1, "maxLength": 256},
          "fail_closed": {"const": true}
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "argv", "completion_conditions"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1, "maxLength": 512},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "completion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "expected", "read_only"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected": {"type": "string", "minLength": 1, "maxLength": 512},
          "read_only": {"const": true}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "approved_at", "approval_reference", "scope"],
      "properties": {
        "approver": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"},
        "approved_at": {"type": "string", "format": "date-time"},
        "approval_reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
