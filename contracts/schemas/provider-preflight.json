{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-loop.dev/schemas/provider-preflight-v1.json",
  "title": "Provider preflight record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "created_at", "correlation_id", "task_id", "provider", "limits", "environment", "rollback", "verification", "approval"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "provider-preflight"},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "pattern": "^V2-[0-9]{3}$"},
    "expires_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "maxLength": 4096},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_path"],
      "properties": {
        "name": {"enum": ["codex", "claude", "opencode"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "executable_path": {"type": "string", "pattern": "^/.{1,512}$"}
      }
    },
    "limits": {
      "type": "object",
      "description": "Runaway-detection thresholds for subscription-metered Provider usage. Not a billing budget: reaching a threshold is a fail-closed stop for inspection, never a success and never a billing event.",
      "additionalProperties": false,
      "required": ["max_invocations", "max_total_cost_usd", "worst_case_reservation_usd", "currency", "window", "ledger_path", "enforced_by", "fail_closed"],
      "properties": {
        "max_invocations": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_total_cost_usd": {"type": "number", "minimum": 0, "maximum": 100, "description": "Ceiling on the CLI-reported cumulative total_cost_usd, used as a consumption proxy to detect runaway loops under a flat-rate subscription. Kept because it is the only per-invocation consumption scalar the CLI reports; invocation count alone cannot catch a single invocation with unbounded context growth."},
        "worst_case_reservation_usd": {"type": "number", "minimum": 0, "maximum": 100},
        "currency": {"const": "USD"},
        "window": {"enum": ["total"]},
        "ledger_path": {"type": "string", "pattern": "^/.{1,512}$"},
        "enforced_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "fail_closed": {"const": true}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_names", "granted_names"],
      "properties": {
        "base_names": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}},
        "granted_names": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "argv", "completion_conditions"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1, "maxLength": 512},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "completion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "expected", "read_only"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected": {"type": "string", "minLength": 1, "maxLength": 512},
          "read_only": {"const": true}
        }
      }
    },
    "approval": {
      "type": "object",
      "description": "References the human owner's standing provider authorization, recorded once. subject_path and subject_digest bind this record to the standing authorization packet, not to a per-task approval.",
      "additionalProperties": false,
      "required": ["approver", "approved_at", "approval_reference", "scope", "subject_path", "subject_digest"],
      "properties": {
        "approver": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"},
        "approved_at": {"type": "string", "format": "date-time"},
        "approval_reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope": {"type": "string", "minLength": 1, "maxLength": 512},
        "subject_path": {"type": "string", "pattern": "^\\.agents/v2/packets/[A-Za-z0-9._-]+\\.json$"},
        "subject_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
