#!/usr/bin/env bash
# SC2034: shared globals are declared here and consumed by the sourced modules.
# SC1091: modules are sourced at runtime; `source=` directives document the path
# for shellcheck -x / editors and are followed only when -x is enabled.
# shellcheck disable=SC2016,SC2034,SC2155,SC1091,SC2154
set -euo pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT="$(git -C "$SCRIPT_ROOT" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$SCRIPT_ROOT")"
readonly STATE_ROOT="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || printf '%s/.git' "$REPO_ROOT")/agentic-loop"
readonly RUNTIME_PATH_FILE="$STATE_ROOT/runtime.path"
readonly RUNTIME_ROOT="$STATE_ROOT/runtime"

# Installation records the verified tool directories outside the worktree.
# Restore them before configuration parsing so public commands work from an
# ordinary shell without requiring devbox shell, direnv, or a host yq package.
if [[ -r $RUNTIME_PATH_FILE ]]; then
  runtime_path=''
  IFS= read -r runtime_path < "$RUNTIME_PATH_FILE" || true
  if [[ -n $runtime_path && $runtime_path != *$'\n'* && $runtime_path != *$'\r'* ]]; then
    export PATH="$runtime_path:$PATH"
  fi
  unset runtime_path
fi

# The recorded PATH normally makes yq resolvable with no extra work. If the
# install-owned Devbox profile it points at was nonetheless GC'd (an operator
# ran a broader nix GC than the gcroot was meant to survive), rebuild it once
# and retry before giving up; this is the only place this script pays for a
# devbox invocation, and only on this already-broken path.
if ! command -v yq >/dev/null 2>&1 && [[ -f $RUNTIME_ROOT/devbox.json ]] && command -v devbox >/dev/null 2>&1; then
  if devbox run --config "$RUNTIME_ROOT" -- true >/dev/null 2>&1; then
    export PATH="$RUNTIME_ROOT/.devbox/nix/profile/default/bin:$PATH"
  fi
fi
readonly WORKTREE_ROOT="$(dirname "$REPO_ROOT")/$(basename "$REPO_ROOT")-worktrees"
readonly CONFIG_FILE="$REPO_ROOT/.agentic-loop.toml"
readonly CONFIG_LOCAL="$REPO_ROOT/.agentic-loop.local.toml"
readonly LABELS=(queued running needs-input in-review stopping completed failed parked stale blocked paused cancelled superseded duplicate merged)
readonly DISPOSITION_LABELS=(cancelled superseded duplicate merged)
# Legacy priority:* label to numeric marker mapping, used only by the one-time
# setup migration (docs/decisions/0015-numeric-priority-marker.md). New queue
# ordering reads the numeric body marker directly; priority labels are never
# created and their numeric value is never re-read from labels.
readonly -A PRIORITY_LEGACY_VALUES=([critical]=90 [high]=75 [medium]=50 [low]=25)
readonly CATEGORY_LABELS=(loop-continuity confidentiality-incident integrity-incident availability-incident feature improvement)
readonly DIAGNOSIS_LABEL=diagnosis
# Grace before a lock without a published pid is treated as stale, so two
# concurrent starts cannot tear down each other's fresh lock and double-run.
readonly SUPERVISOR_LOCK_GRACE_SECONDS=10
# How long the supervisor pauses claiming after a worker hits a token/rate limit,
# before it re-checks whether the provider budget has recovered.
readonly EXHAUSTION_PAUSE_SECONDS=1800
# Consecutive dependency-check API failures tolerated before an Issue is
# actually moved to agent:blocked, so a single poll's transient blip does not
# flap the label; claiming is still withheld from the first failure onward.
readonly DEPENDENCY_FAILURE_TOLERANCE=3
# Bound on how far dependency cycle detection walks the blocked_by graph.
readonly DEPENDENCY_MAX_DEPTH=10
readonly DECOMPOSITION_SCHEMA_VERSION=1
readonly DECOMPOSITION_MAX_DIRECT_CHILDREN=6
readonly DECOMPOSITION_MIN_DIRECT_CHILDREN=2
readonly DECOMPOSITION_MAX_DEPTH=2
readonly DECOMPOSITION_MAX_DESCENDANTS=20
# Below this, worker_timeout_seconds risks killing a worker still doing
# legitimate work (plan+exec+PR review can easily take an hour); doctor warns
# but does not fail, since some deployments may accept the risk deliberately.
readonly WORKER_TIMEOUT_MIN_SAFE_SECONDS=1800
# Local-only progress observability (see docs/decisions/0005): a worker marks
# its stage boundaries in workers/<issue>.progress and mirrors a safe enum row
# into events.log; status reads the markers while tail and status --watch stream
# events.log (the worker log's mtime is a secondary stall signal in status),
# all with zero GitHub calls. A worker whose last progress is older than
# STATUS_STALL_SECONDS is surfaced as stalled (observation only -- automatic
# termination stays the worker_timeout_seconds domain of ADR 0006).
readonly STATUS_STALL_SECONDS=300
# Legacy `status --watch [N]` interval: still parsed and validated for backward
# compatibility, but ignored because --watch now follows events.log instead of
# re-rendering on a timer.
readonly STATUS_WATCH_DEFAULT_SECONDS=2
readonly STATUS_GITHUB_TTL_SECONDS=60
readonly TAIL_MAX_LINES=100
# Only enum stages are persisted, so a provider's free-form text can never be
# smuggled into local state or the events stream (secret boundary).
readonly PROGRESS_STAGES=(claim resume worktree plan preflight exec replan checks review merge cleanup 'done' failed needs-input queued blocked stopped)
readonly EVENTS_LOG="$STATE_ROOT/events.log"
readonly PROJECT_OPERATION_BUDGET=25
readonly PROJECT_RECONCILE_BATCH=10

cd "$REPO_ROOT"

POLL_SECONDS=30
POLL_MAX_SECONDS=120
MAX_WORKERS=4
LEASE_SECONDS=300
STOP_TIMEOUT=0
PAUSE_GRACE_SECONDS=120
STALE_DAYS=30
GRAPHQL_RESERVE=500
CORE_RESERVE=500
RATE_LIMIT_CACHE_SECONDS=15
API_RETRY_ATTEMPTS=3
API_RETRY_BASE_SECONDS=1
MAX_ATTEMPTS=3
RETRY_COOLDOWN_SECONDS=600
WORKER_TIMEOUT_SECONDS=14400
UNKNOWN_SCOPE=isolated
EXCLUSIVE_PATHS=''
TRACEABILITY=off
PREFLIGHT=off
CONFIG_ERROR=''
CONFIG_PROPS=''

# Source the implementation modules in dependency order (see ADR 0013).
# Modules hold function definitions only; all I/O happens when main runs.
# shellcheck source=lib/agentic-loop/common.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/common.sh"
# shellcheck source=lib/agentic-loop/config.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/config.sh"
# shellcheck source=lib/agentic-loop/capability.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/capability.sh"
# shellcheck source=lib/agentic-loop/api.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/api.sh"
# shellcheck source=lib/agentic-loop/agent.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/agent.sh"
# shellcheck source=lib/agentic-loop/setup.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/setup.sh"
# shellcheck source=lib/agentic-loop/priority.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/priority.sh"
# shellcheck source=lib/agentic-loop/service.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/service.sh"
# shellcheck source=lib/agentic-loop/status.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/status.sh"
# shellcheck source=lib/agentic-loop/doctor.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/doctor.sh"
# shellcheck source=lib/agentic-loop/upgrade.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/upgrade.sh"
# shellcheck source=lib/agentic-loop/metrics.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/metrics.sh"
# shellcheck source=lib/agentic-loop/project.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/project.sh"
# shellcheck source=lib/agentic-loop/dispose.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/dispose.sh"
# shellcheck source=lib/agentic-loop/worker_state.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/worker_state.sh"
# shellcheck source=lib/agentic-loop/control.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/control.sh"
# shellcheck source=lib/agentic-loop/dependency.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/dependency.sh"
# shellcheck source=lib/agentic-loop/scope.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/scope.sh"
# shellcheck source=lib/agentic-loop/preflight.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/preflight.sh"
# shellcheck source=lib/agentic-loop/flaky.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/flaky.sh"
# shellcheck source=lib/agentic-loop/trace.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/trace.sh"
# shellcheck source=lib/agentic-loop/supervisor.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/supervisor.sh"
# shellcheck source=lib/agentic-loop/worker.sh
source "$SCRIPT_ROOT/bin/lib/agentic-loop/worker.sh"

# Resolve configuration once, up front, for every command. doctor tolerates
# an unreadable config so it can diagnose the very environment that broke it.
load_config || { [[ ${1:-} == doctor ]] || fail "$CONFIG_ERROR"; }

usage() {
  cat >&2 <<EOF
Usage: $PROGRAM_NAME {setup|sync-issue ISSUE|dispose ISSUE --reason cancelled|superseded|duplicate|merged [--target ISSUE]|resume ISSUE|pause ISSUE [--reason TEXT]|abort ISSUE [--reason TEXT]|priority ISSUE N|start|stop|status [--format json] [--watch [N]]|doctor [--format json]|metrics [--days N] [--as-of EPOCH] [--format json]|tail [--issue N] [--follow]|trace ISSUE [--format json]|trace --audit [--days N] [--format json]|capabilities [--format json]|preflight ISSUE [--format json]|preflight ISSUE --approve --token TOKEN [--note TEXT]|flaky [--format json]|flaky report [--record PATH]|upgrade [--source PATH|--revision SHA] [--apply] [--approve] [--rollback] [--skip-verify] [--overwrite PATH]... [--format json]}

  setup   Create or reuse this repository's labels and Project
  sync-issue  Add one Issue to the Project now, or queue a retry
  dispose     Authorized, auditable cancellation or consolidation of an Issue
  resume      Authorized re-queue of a disposed (closed), parked (open), or paused (open) Issue
  pause       Authorized, non-terminal pause of one Issue's execution (queue/worker untouched otherwise)
  abort       Authorized, non-terminal abort of one Issue's execution into agent:parked (no disposal)
  priority    Set an Issue's numeric priority (0-100) via its body marker
  start   Start one background supervisor for this repository
  stop    Stop claiming work and drain running workers
  status  Show what is running, queued, waiting, and any anomalies (always exit 0)
          status --watch [N] streams events.log like tail -f (TTY only; prints the
          recent events once and exits on a pipe/redirect; the legacy interval is ignored)
  doctor  Read-only checks with remediation guidance (exit 1 on failures)
  metrics Read-only queue/lifecycle metrics over recent history (always exit 0)
  tail    Stream supervisor/worker stage/progress events with timestamps (REST 0)
  trace   Read-only requirement-to-evidence traceability for one Issue, or --audit across the repository (exit 1 on unmet criteria or a missing PR)
  capabilities  Read-only repository capability manifest (validation/environment/skills/etc.); exit 1 on an unsafe or unreadable manifest
  preflight     Read-only change-risk preflight signal for one Issue (exit 1 when repository signals require approval); --approve records an authorized operator's approval of one risk envelope token
  flaky   Read-only flaky-test registry status (exit 1 on an expired or invalid tests/flaky-registry.toml entry); flaky report creates/reuses repair Issues from the last run-e2e.sh record
  upgrade Preview (default) or apply a Foundation update; see docs/operations/upgrade.md
EOF
}

main() {
  case ${1:-} in
    setup) [[ $# -eq 1 ]] || fail 'setup takes no arguments'; cmd_setup ;;
    sync-issue) [[ $# -eq 2 ]] || fail 'sync-issue requires one Issue number'; cmd_sync_issue "$2" ;;
    dispose) cmd_dispose "${@:2}" ;;
    resume) [[ $# -eq 2 ]] || fail 'resume requires one Issue number'; cmd_resume "$2" ;;
    pause) cmd_pause "${@:2}" ;;
    abort) cmd_abort "${@:2}" ;;
    priority) cmd_priority "$2" "$3" ;;
    start) [[ $# -eq 1 ]] || fail 'start takes no arguments'; cmd_start ;;
    stop) [[ $# -eq 1 ]] || fail 'stop takes no arguments'; cmd_stop ;;
    status) cmd_status "${@:2}" ;;
    doctor) cmd_doctor "$@" ;;
    metrics) cmd_metrics "$@" ;;
    tail) cmd_tail "${@:2}" ;;
    trace) cmd_trace "${@:2}" ;;
    capabilities) cmd_capabilities "$@" ;;
    preflight) cmd_preflight "${@:2}" ;;
    flaky) cmd_flaky "${@:2}" ;;
    upgrade) cmd_upgrade "$@" ;;
    _service) [[ $# -eq 1 ]] || exit 2; cmd_service ;;
    _supervise) supervise ;;
    _pick-tier) [[ $# -eq 2 ]] || exit 2; agent_pick_tier "$2" || exit $? ;;
    _worker) [[ $# -eq 3 ]] || exit 2; worker "$2" "$3" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
